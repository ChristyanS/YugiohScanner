# Configuração do Yu-Gi-Oh! Collection Scanner.
# Copie para `.env` e ajuste. NENHUMA variável é obrigatória — os valores
# abaixo são os defaults. Nunca comite o `.env` (já está no .gitignore).

# ---------------------------------------------------------------------- dados
# Raiz dos dados gerados: banco, cache de imagens, uploads, logs, backups.
# Caminho relativo é resolvido contra a raiz do projeto, não contra o cwd.
#YGS_DATA_PATH=data

# URL SQLAlchemy. Se omitida, é derivada de YGS_DATA_PATH.
#YGS_DATABASE_URL=sqlite:///data/yugioh.db

# Cache de imagens. Se omitido, YGS_DATA_PATH/images.
#YGS_IMAGE_CACHE_PATH=data/images

# Allowlist de pastas escaneáveis (JSON). Vazio = qualquer pasta (modo local).
# Preencha se for expor a interface web para fora da máquina.
#YGS_ALLOWED_SCAN_ROOTS=["C:/Users/voce/Pictures/cartas"]

# ------------------------------------------------------------------------ OCR
# rapidocr (padrão, sem dependência de sistema) | tesseract | paddle | easyocr | claude
#YGS_OCR_PROVIDER=rapidocr

# Reprocessa apenas as leituras de baixa confiança com um motor melhor.
# none (padrão) | claude
#YGS_OCR_FALLBACK_PROVIDER=none

# Workers de OCR local. Omitido = automático (metade dos núcleos, teto 8).
# Medição real mostra que o OCR satura banda de memória: mais workers que isso
# não aumenta o throughput.
#YGS_OCR_WORKERS=

#YGS_OCR_TIMEOUT_S=60

# Threads que cada worker de OCR pode usar. Vazio = automático (todos os
# núcleos no modo serial, 1 dentro do pool). Mexer aqui sem medir costuma
# deixar mais lento: N workers com N threads cada disputam os mesmos núcleos.
#YGS_OCR_THREADS_PER_WORKER=

# Só necessário se o Tesseract não estiver no PATH.
#YGS_TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# ------------------------------------------------------------------------ LLM
# Usado apenas se OCR_PROVIDER ou OCR_FALLBACK_PROVIDER for "claude".
# A chave é lida daqui OU de ANTHROPIC_API_KEY. Nunca é gravada no banco,
# nunca aparece em log, e sai mascarada em `yugioh-scanner config show`.
#ANTHROPIC_API_KEY=

#YGS_LLM_MODEL=claude-opus-5
#YGS_LLM_CONCURRENCY=4
# Message Batches: metade do custo, assíncrono. Bom para pastas grandes.
#YGS_LLM_USE_BATCHES=false

# ------------------------------------------------------------------- matching
# Acima disto entra na coleção sozinho; abaixo de REVIEW exige revisão manual.
# Estes valores serão calibrados na Fase 9 com fotos reais.
#YGS_CONFIDENCE_AUTO=0.93
#YGS_CONFIDENCE_REVIEW=0.70
#YGS_FUZZY_CUTOFF=70

# ----------------------------------------------------------------------- rede
#YGS_YGOPRODECK_BASE_URL=https://db.ygoprodeck.com/api/v7
# O limite deles é 20/s; usamos metade de propósito.
#YGS_HTTP_RATE_LIMIT_PER_S=10.0
#YGS_HTTP_CONNECT_TIMEOUT_S=10.0
#YGS_HTTP_READ_TIMEOUT_S=60.0
#YGS_HTTP_MAX_RETRIES=3
#YGS_HTTP_BACKOFF_BASE_S=1.0

# ------------------------------------------------------------------------ web
# 127.0.0.1 por default: NÃO há autenticação nesta versão.
#YGS_WEB_HOST=127.0.0.1
#YGS_WEB_PORT=8000
#YGS_MAX_UPLOAD_MB=100
#YGS_MAX_UPLOAD_FILES=200
#YGS_MAX_IMAGE_PIXELS=40000000

# -------------------------------------------------------------- observabilidade
#YGS_LOG_LEVEL=INFO
# console (humano) | json (uma linha por evento, para diagnóstico)
#YGS_LOG_FORMAT=console
